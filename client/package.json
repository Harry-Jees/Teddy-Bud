{
  "name": "teddy-bud",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "web": "vite --host 127.0.0.1 --open",
    "build:web": "vite build --outDir ../dist/web",
    "build:dist": "npm run desktop:build",
    "desktop:run": "electron desktop/main.cjs",
    "desktop:prepare": "node desktop/prepare-package.cjs",
    "desktop:build": "npm run build:web -- --base=./ && npm run desktop:prepare && electron-builder --projectDir .desktop-package --config electron-builder.yml --publish never",
    "desktop:windows": "npm run desktop:build -- --win nsis",
    "desktop:macos": "npm run desktop:build -- --mac dmg",
    "desktop:linux": "npm run desktop:build -- --linux deb AppImage",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest"
  },
  "dependencies": {
    "@op-engineering/op-sqlite": "^18.2.5",
    "@react-native-documents/picker": "^12.0.3",
    "react": "19.2.0",
    "react-dom": "^19.2.0",
    "react-native": "0.83.10",
    "react-native-file-access": "^4.0.4",
    "react-native-get-random-values": "^2.0.0",
    "react-native-keychain": "^10.0.0",
    "react-native-macos": "^0.83.0",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-quick-base64": "^3.0.1",
    "react-native-quick-crypto": "^1.1.8",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-web": "^0.21.4"
  },
  "op-sqlite": {
    "sqlcipher": true
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.83.10",
    "@react-native/eslint-config": "0.83.10",
    "@react-native/metro-config": "0.83.10",
    "@react-native/typescript-config": "0.83.10",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.0",
    "typescript": "^5.8.3",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
